  "main": "dist/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "dev:inngest": "pnpm dlx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "start": "node --env-file-if-exists=.env src/server.ts",

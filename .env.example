# Postgres connection string (Supabase pooler)
DATABASE_URL=

# Supabase project URL, used to verify user tokens
SUPABASE_URL=

# Supabase secret key, used to verify user tokens
SUPABASE_SECRET_ACCESS_KEY=

# OpenAI key for the LangGraph agent
OPENAI_API_KEY=

# Model the agent runs on (defaults to gpt-5.4-mini)
OPENAI_MODEL=

# Inngest. Both are optional: the local dev server (`pnpm dev:inngest`) needs
# neither, production needs both. Inngest reads them from the environment.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Runtime environment: development | test | production (defaults to development)
NODE_ENV=

# Express server port (defaults to 3000)
PORT=

# Log level: trace | debug | info | warn | error | fatal | silent (defaults to info)
LOG_LEVEL=
